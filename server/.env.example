# 文件内分别只放一行 secret。Compose 通过 Docker secrets 只读挂载，不把值写入环境。
PROXY_ACCESS_TOKEN_SECRET_FILE=./secrets/proxy_access_token.txt
VISION_API_KEY_SECRET_FILE=./secrets/vision_api_key.txt
VISION_API_BASE_URL=https://your-openai-compatible-provider.example/v1
VISION_MODEL=replace-with-a-vision-capable-model
STATE_DB_PATH=/var/lib/meal-analyzer/state.db
UVICORN_WORKERS=2

# 请求入口保护：约 12.5 MB 可容纳 App 当前最大 8 MB JPEG 的 Base64 JSON。
MAX_REQUEST_BODY_BYTES=12500000
REQUEST_RATE_LIMIT=10
REQUEST_RATE_WINDOW_SECONDS=60

# 仅填写与 Uvicorn 建立 TCP 连接的受信反向代理 IP/CIDR；禁止使用 *。
# 未设置时 Uvicorn 只允许 127.0.0.1；样例额外允许 IPv6 loopback。直连公网时可设为空。
FORWARDED_ALLOW_IPS=127.0.0.1,::1

# 失败鉴权按可信客户端来源限速；达到阈值后指数退避。正确令牌不继承失败退避。
AUTH_FAILURE_LIMIT=5
AUTH_FAILURE_WINDOW_SECONDS=60
AUTH_BACKOFF_BASE_SECONDS=2
AUTH_BACKOFF_MAX_SECONDS=60
AUTH_SOURCE_CAPACITY=4096
AUTH_SOURCE_TTL_SECONDS=3600

# 同一台宿主机/同一 SQLite WAL 卷上的所有 worker 共享以下付费调用保护。
MAX_CONCURRENT_PROVIDER_CALLS=2
DAILY_PROVIDER_CALL_LIMIT=200
PROVIDER_DEADLINE_SECONDS=20
PROVIDER_RESPONSE_MAX_BYTES=1048576
PROVIDER_LEASE_SECONDS=45

# 相同 token + key + payload 的执行租约会持久化。默认还会在 SQLite 明文保留
# 完整终态响应 7 天（不保存 JPEG 原图）；生产状态卷应启用静态加密。
# 设为 0 会在请求完成时立即删除运行中记录，不保留终态响应/不提供重放。
IDEMPOTENCY_LEASE_SECONDS=45
IDEMPOTENCY_RETENTION_SECONDS=604800
IDEMPOTENCY_CAPACITY=10000

# 只能在本机开发、且上游地址为 localhost/127.0.0.1/::1 时临时开启。
ALLOW_INSECURE_PROVIDER_HTTP=false
